# RM Skills — environment variables
# Copy to .env and fill in your values. Never commit .env.
#
# Required: Claude Code CLI
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Required: GitHub
# ─────────────────────────────────────────────────────────────────────────────
# Run: gh auth login
# Or set a personal access token (scopes: repo, read:org, workflow):
GITHUB_TOKEN=ghp_...

# Required: Jira — Truthly
# ─────────────────────────────────────────────────────────────────────────────
# Create at: https://truthly-ai.atlassian.net/manage-profile/security/api-tokens
JIRA_TRUTHLY_EMAIL=you@example.com
JIRA_TRUTHLY_API_TOKEN=...
JIRA_TRUTHLY_BASE_URL=https://truthly-ai.atlassian.net

# Required: Jira — Mozart / Palmetto
# ─────────────────────────────────────────────────────────────────────────────
# Create at: https://ryan-miranda.atlassian.net/manage-profile/security/api-tokens
JIRA_MOZART_EMAIL=you@example.com
JIRA_MOZART_API_TOKEN=...
JIRA_MOZART_BASE_URL=https://ryan-miranda.atlassian.net

# Required: Slack
# ─────────────────────────────────────────────────────────────────────────────
# Create a Slack app at https://api.slack.com/apps with scopes:
#   channels:read, channels:history, groups:read, groups:history,
#   im:read, im:history, mpim:read, mpim:history,
#   search:read, users:read, files:read
SLACK_BOT_TOKEN=xoxb-...
SLACK_TEAM_ID=T...   # visible in your Slack workspace URL

# Optional: Google (Gmail + Drive)
# ─────────────────────────────────────────────────────────────────────────────
# OAuth credentials from https://console.cloud.google.com/
# Scopes: gmail.readonly, drive.readonly (or wider if you need to create/edit)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...

# Optional: Figma
# ─────────────────────────────────────────────────────────────────────────────
# Create at: https://www.figma.com/settings → Personal access tokens
FIGMA_ACCESS_TOKEN=figd_...
