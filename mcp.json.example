{
  "mcpServers": {
    "jira-truthly": {
      "command": "npx",
      "args": ["-y", "mcp-server-jira"],
      "env": {
        "JIRA_BASE_URL": "${JIRA_TRUTHLY_BASE_URL}",
        "JIRA_EMAIL": "${JIRA_TRUTHLY_EMAIL}",
        "JIRA_API_TOKEN": "${JIRA_TRUTHLY_API_TOKEN}"
      }
    },
    "jira-mozart": {
      "command": "npx",
      "args": ["-y", "mcp-server-jira"],
      "env": {
        "JIRA_BASE_URL": "${JIRA_MOZART_BASE_URL}",
        "JIRA_EMAIL": "${JIRA_MOZART_EMAIL}",
        "JIRA_API_TOKEN": "${JIRA_MOZART_API_TOKEN}"
      }
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      }
    },
    "google-drive": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-gdrive"],
      "env": {
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET}",
        "GOOGLE_REFRESH_TOKEN": "${GOOGLE_REFRESH_TOKEN}"
      }
    },
    "figma": {
      "command": "npx",
      "args": ["-y", "mcp-server-figma"],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}"
      }
    }
  }
}
