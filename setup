#!/usr/bin/env bash
# rm-skills installer: symlinks skills/ into ~/.claude/skills/rm so Claude Code discovers them.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILLS_SRC="$REPO_DIR/skills"
SKILLS_DEST="$HOME/.claude/skills/rm"

if [ ! -d "$SKILLS_SRC" ]; then
  echo "error: $SKILLS_SRC does not exist" >&2
  exit 1
fi

mkdir -p "$HOME/.claude/skills"

if [ -L "$SKILLS_DEST" ]; then
  existing_target="$(readlink "$SKILLS_DEST")"
  if [ "$existing_target" = "$SKILLS_SRC" ]; then
    echo "already installed: $SKILLS_DEST -> $SKILLS_SRC"
    exit 0
  fi
  echo "removing existing symlink $SKILLS_DEST (was -> $existing_target)"
  rm "$SKILLS_DEST"
elif [ -e "$SKILLS_DEST" ]; then
  ts="$(date +%Y%m%d-%H%M%S)"
  backup="$SKILLS_DEST.backup-$ts"
  echo "backing up existing $SKILLS_DEST -> $backup"
  mv "$SKILLS_DEST" "$backup"
fi

ln -s "$SKILLS_SRC" "$SKILLS_DEST"
echo "installed: $SKILLS_DEST -> $SKILLS_SRC"
echo "verify: ls $SKILLS_DEST | head"
